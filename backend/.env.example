# Application
PROJECT_NAME=Healthcare System API
VERSION=1.0.0
API_V1_STR=/api/v1
DEBUG=True

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=healthcare_user
POSTGRES_PASSWORD=healthcare_password
POSTGRES_DB=healthcare_db

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Email (SendGrid/SMTP)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
AWS_REGION=us-east-1

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ----- RAG Engine: Vector DB -----
VECTOR_DB_PROVIDER=pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=healthcare-rag
WEAVIATE_URL=http://localhost:8080

# ----- RAG Engine: LLM -----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
MAX_PROMPT_TOKENS=6000

# ----- RAG Engine: Tuning -----
TOP_K_RETRIEVAL=10
TOP_K_FINAL=5
MIN_VALID_SOURCES=2
MIN_CONFIDENCE_SCORE=0.7
CACHE_TTL_SECONDS=300

# ----- RAG Engine: Source Allowlist (comma-separated) -----
TRUSTED_DOMAINS=cdc.gov,who.int,pubmed.ncbi.nlm.nih.gov,fda.gov,nih.gov,mayoclinic.org,clevelandclinic.org,medlineplus.gov

# Copy to actual .env file
cp .env.example .env